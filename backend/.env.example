PORT=3001
APP_URL=http://localhost:3001

LLM_PROVIDER=ollama

# Apple Silicon: Ollama uses Metal GPU automatically (no MPS config in this app).
# Recommended for ≤5 min / 10 transcripts on M-series Mac:
#   ollama pull qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_MODEL_LABEL=Qwen3 8B
OLLAMA_THINK=false
OLLAMA_MAX_TOKENS=1024
OLLAMA_KEEP_ALIVE=30m
TRANSCRIPT_CONCURRENCY=1
ANALYSIS_CACHE=true
RUN_LOGS=true

# Production / Render (APP_URL optional — Render sets RENDER_EXTERNAL_URL)
# APP_URL=https://your-service.onrender.com
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# TRANSCRIPT_CONCURRENCY=4
