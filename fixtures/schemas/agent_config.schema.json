{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_config.schema.json",
  "title": "VoiceAIAgentConfig",
  "type": "object",
  "required": ["agentId", "name", "goal", "prompt", "model", "temperature", "tools", "knowledgeBase", "guardrails"],
  "properties": {
    "agentId": { "type": "string" },
    "name": { "type": "string" },
    "goal": { "type": "string" },
    "prompt": { "type": "string" },
    "model": { "type": "string" },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
    "voice": { "type": "string" },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "enabled"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "enabled": { "type": "boolean" }
        }
      }
    },
    "knowledgeBase": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "answer"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "answer": { "type": "string" }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "required": ["escalationTriggers", "prohibitedClaims"],
      "properties": {
        "escalationTriggers": { "type": "array", "items": { "type": "string" } },
        "prohibitedClaims": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
