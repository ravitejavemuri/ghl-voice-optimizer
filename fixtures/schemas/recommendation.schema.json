{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recommendation.schema.json",
  "title": "OptimizationRecommendations",
  "type": "object",
  "required": ["agentId", "generatedAt", "configAreaReviews", "recommendations"],
  "properties": {
    "agentId": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "frozenAt": { "type": "string", "format": "date-time" },
    "llmModel": { "type": "string" },
    "llmModelLabel": { "type": "string" },
    "configAreaReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "area", "needs_change", "note"],
        "properties": {
          "key": { "type": "string" },
          "area": { "type": "string" },
          "needs_change": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "category", "priority", "before", "after", "reason", "expected_impact"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "category": { "type": "string" },
          "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
          "issue": { "type": "string" },
          "before": { "type": "string" },
          "after": { "type": "string" },
          "reason": { "type": "string" },
          "expected_impact": { "type": "string" }
        }
      }
    }
  }
}
